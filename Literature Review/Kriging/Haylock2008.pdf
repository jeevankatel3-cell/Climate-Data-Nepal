      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geographic Location: Europe; Oceanography: General: Climate and interannual variability; Atmospheric Processes: Climate change and variability; Atmospheric Processes: Precipitation; Atmospheric Composition and Structure: Pressure, density, and temperature</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A European daily high&amp;hyphen;resolution gridded data set of surface temperature and precipitation for 1950&amp;ndash;2006</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>M. R. Haylock, N. Hofstra, A. M. G. Klein Tank, E. J. Klok, P. D. Jones, M. New</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
